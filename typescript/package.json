{
  "name": "@waffle/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Waffle merchant API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "waffle",
    "sdk",
    "payments"
  ],
  "license": "MIT",
  "homepage": "https://getwaffle.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getwaffle/sdk.git",
    "directory": "typescript"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
