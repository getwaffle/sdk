{
  "name": "@getwaffle/mcp",
  "version": "0.1.1",
  "description": "MCP server exposing the Waffle merchant API as tools for AI coding agents (Claude Code, Cursor, VS Code Copilot, ...)",
  "type": "module",
  "bin": {
    "waffle-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "waffle",
    "mcp",
    "model-context-protocol",
    "payments"
  ],
  "license": "MIT",
  "homepage": "https://getwaffle.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getwaffle/sdk.git",
    "directory": "mcp"
  },
  "dependencies": {
    "@getwaffle/sdk": "file:../typescript",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.6.6",
    "tsup": "^8.3.5",
    "tsx": "^4.20.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
